# Unique host-side ports (all services also use a private Docker network)
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
API_HOST_PORT=58080
CUSTOMER_HOST_PORT=53000
ADMIN_HOST_PORT=53001
DRIVER_HOST_PORT=53002

POSTGRES_DB=suabhi_cab_booking_db
POSTGRES_USER=cab_booking_app
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD_32_CHARS
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_32_CHARS

SPRING_PROFILES_ACTIVE=local
PUBLIC_API_URL=http://localhost:58080/api/v1
APP_CORS_ALLOWED_ORIGINS=http://localhost:53000,http://localhost:53001,http://localhost:53002
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
HSTS_ENABLED=false

# Google Maps Platform (optional in local development; keep the key out of Git)
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_CONNECT_TIMEOUT=3s
GOOGLE_MAPS_READ_TIMEOUT=8s
GOOGLE_MAPS_REQUESTS_PER_SECOND=8
GOOGLE_MAPS_MAX_SUGGESTIONS=5

# LOCAL PREVIEW ONLY: demo password is bundled into the admin JavaScript and is NOT a secret.
# Do not expose this build to other users or use demo mode in production.
VITE_BACKEND=false
VITE_DEMO_MODE=true
VITE_DEMO_EMAIL=admin@suabhi.local
VITE_DEMO_PASSWORD=local-preview-only
